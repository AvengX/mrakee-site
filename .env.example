# ================================================================
# MRAKEE Technologies — Environment Variables
# ================================================================

# Web3Forms API Key (required for Contact Form submissions)
# Obtain a free key at https://web3forms.com
WEB3FORMS_ACCESS_KEY=

# Anthropic API Key (required for Voice Assistant reasoning)
# Obtain at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional Voice Keys (for text-to-speech audio with viseme lip-sync)
# If neither is set, browser speech synthesis is used as fallback
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
